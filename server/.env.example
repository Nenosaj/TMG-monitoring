# ntopng REST API connection
NTOPNG_URL=http://192.168.100.2:3000
NTOPNG_USER=admin
NTOPNG_PASS=replace-with-your-password
NTOPNG_IFID=0

# Multi-VLAN: comma-separated list of VLAN IDs to monitor
# VLAN_IDS takes priority over legacy VLAN_ID
VLAN_IDS=5,10,30,50,60,70,80,100

# Human-readable names for each VLAN (id:Name pairs, comma-separated)
# Built-in defaults: 5:MESH,10:OPERATIONS,30:SALES,50:WEB,60:DMT,70:NETIS,80:CEO,100:DEFAULT
# Uncomment and edit to override specific names:
# VLAN_NAMES=5:MESH,10:OPERATIONS,30:SALES,50:WEB,60:DMT,70:NETIS,80:CEO,100:DEFAULT

# Legacy single-VLAN fallback (ignored if VLAN_IDS is set)
# VLAN_ID=70

# Dashboard and history settings
POLL_INTERVAL_SECONDS=30
RETENTION_DAYS=30
PORT=4070
